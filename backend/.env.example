# Скопируйте в .env и при необходимости поправьте. Реальный .env в git не коммитится.

# Async SQLAlchemy DSN. Локально - sqlite (по условию задания, без внешней инфраструктуры).
DATABASE_URL=sqlite+aiosqlite:///./stand.db

# Лимит размера загружаемого архива, МБ.
MAX_UPLOAD_SIZE_MB=50

# Имитация длительности фоновой обработки, сек.
PROCESSING_DELAY_SECONDS=0.1

# Уровень логирования: DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL=INFO

# Включает echo SQL и подробные ошибки.
DEBUG=false
